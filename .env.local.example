# Client-side (Vite exposes only VITE_-prefixed vars to the browser bundle —
# safe to expose, every table these keys can reach is governed by the RLS
# policies in supabase/migrations/0001_init.sql, not by keeping this secret).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic key for the existing api/advisor.ts serverless function (unrelated
# to Supabase, already required before this migration).
ANTHROPIC_API_KEY=

# Used only by one-off migration/admin scripts in this project (never by the
# shipped app itself) — keep these out of any VITE_-prefixed var, since that
# prefix ships to the browser.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
